# Anthropic API key used by the `verify` CLI (src/cli/verify.ts).
# Copy this file to .env.local and fill in your key.
ANTHROPIC_API_KEY=

# Optional: override the verifier model (default: claude-opus-4-8).
# Use a cheaper/faster model for whole-system fan-out, e.g. claude-haiku-4-5.
KONTUR_VERIFY_MODEL=
